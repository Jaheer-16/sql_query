#step1-create partition

CREATE PARTITION FUNCTION partitionbyyear(DATE)
AS RANGE LEFT FOR VALUES('2023-12-31','2024-12-31','2025-12-31')

---->sys.partition_functions table to check partitions created

#step2-create file groups

ALTER DATABASE SalesDB ADD FILEGROUP 'FG_2023';
ALTER DATABASE SalesDB ADD FILEGROUP 'FG_2024';
ALTER DATABASE SalesDB ADD FILEGROUP 'FG_2025';

----->sys.filegroups to check file groups created

#step3-add .ndf files to the file groups

ALTER DATABASE SalesDB
ADD FILE
(
NAME=file_2023 --logical name
FILE NAME='C:\data\file_2023.ndf'(ACTUAL DATA WHERE YOU ARE TAKING PATH)
)TO FILEGROUP FG_2023;

ALTER DATABASE SalesDB
ADD FILE
(
NAME=file_2024 --logical name
FILE NAME='C:\data\file_2024.ndf'
)TO FILE GROUP FG_2024;

ALTER DATABASE SalesDB
ADD FILE
(
NAME=file_2025 --logical name
FILE NAME='C:\data\file_2025.ndf'
)TO FILE GROUP FG_2025;


#step4-create the partitionschema(mapping of partitions to file groups)

CREATE PARTITION SCHEME partitionschemaforyear
AS PARTITION partitionbyyear
TO(FG_2023,FG_2024,FG_2025,[PRIMARY])


#step5-create partition table

CREATE TABLE sales.orders_partionedtable
(
   orderid INT,
   orderdate DATE,
   score INT
)ON partitionschemaforyear(orderdate);


