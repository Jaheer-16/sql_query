CREATE PROCEDURE CUSTOMERINFO @COUNTRY NVARCHAR(50)='INDIA'
AS
BEGIN
DECLARE @totalcustomers INT, @averageofcustomers FLOAT;

IF EXISTS (SELECT 1 FROM CUSTOMER WHERE SCORE IS NULL AND COUNTRY=@COUNTRY)
 BEGIN
 UPDATE CUSTOMER
 SET SCORE = 0 
 WHERE SCORE IS NULL AND COUNTRY=@COUNTRY
 END
 
ELSE
BEGIN
PRINT('SCORE IS AVAILBLE')
END

SELECT @totalcustomers = COUNT(*),
       @averageofcustomers = AVG(SALES)
	   FROM
	   CUSTOMER
	   WHERE COUNTRY = @COUNTRY;
	   
	   PRINT 'TOTAL CUSTOMER FROM '+@COUNTRY+':'+CAST(@totalcustomers AS NVARCHAR(10));
	   PRINT 'AVERAGE OF CUSTOMER FROM '+@COUNTRY+':'+CAST(@averageofcustomers AS NVARCHAR(20));
	   END;
