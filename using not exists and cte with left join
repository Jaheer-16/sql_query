 Identify products that have never been included in a sales order
 
 SELECT product_name,product_id
 FROM products p
 WHERE NOT EXISTS(
    SELECT 1 FROM orders o
	WHERE o.product_id=p.product_id
 )
   
   OR
   
  WITH cte_cust AS (
   SELECT DISTINCT cust_id,cust_name
   FROM customer c
   LEFT JOIN orders o
   ON c.cust_id=o.cust_id
   WHERE o.cust_id IS NULL
   )SELECT * FROM cte_cust;
